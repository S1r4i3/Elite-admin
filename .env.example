# Supabase (required in production) — Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional, default client-documents
SUPABASE_DOCUMENTS_BUCKET=client-documents

# 16+ random characters — signs the admin session cookie
SESSION_SECRET=

# Local mode only (no Supabase): first Admin login and upload folder
ADMIN_EMAIL=admin@elitebtax.com
ADMIN_PASSWORD=
UPLOAD_DIR=./data/uploads
