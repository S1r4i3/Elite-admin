SESSION_SECRET=change-me-to-a-long-random-string


ADMIN_EMAIL=admin@elitebtax.com
ADMIN_PASSWORD=choose-a-strong-password

# Where uploaded files are stored on disk.
UPLOAD_DIR=./data/uploads

DEBUG=True

SECRET_KEY=your-django-secret-key

DB_NAME=elitebtax
DB_USER=elitebtax_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

FRONTEND_URL=http://localhost:4000
# ── Live website data (Supabase) ─────────────────────────
# Same project as the website. Server-side only — never expose the service key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DOCUMENTS_BUCKET=client-documents
